# ============================================
# Database Configuration
# ============================================
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/nombre_db
#
# Desglose:
#   postgresql+asyncpg  → Dialecto + Driver (le dice a SQLAlchemy cómo conectarse)
#   usuario:contraseña  → Credenciales de PostgreSQL
#   host:puerto         → Dónde está corriendo PostgreSQL
#   nombre_db           → Nombre de la base de datos
#
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db

# ============================================
# Application Settings
# ============================================
APP_NAME=RAG FastAPI
DEBUG=true

# ============================================
# LLM Configuration (Gemini)
# ============================================
# Obtener gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu-api-key-aqui

# Modelo a usar (opciones: gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.0-flash

# ============================================
# Memory Configuration
# ============================================
# Estrategia de memoria activa: none | sliding | summary | vector | hybrid
MEMORY_STRATEGY=none

# Configuración específica por estrategia
MEMORY_SLIDING_WINDOW_SIZE=10
MEMORY_VECTOR_TOP_K=5
MEMORY_SUMMARY_THRESHOLD=20
MEMORY_MAX_CONTEXT_TOKENS=2000
