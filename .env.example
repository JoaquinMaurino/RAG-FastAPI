# ============================================
# Database Configuration
# ============================================
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/nombre_db
#
# Desglose:
#   postgresql+asyncpg  → Dialecto + Driver (le dice a SQLAlchemy cómo conectarse)
#   usuario:contraseña  → Credenciales de PostgreSQL
#   host:puerto         → Dónde está corriendo PostgreSQL
#   nombre_db           → Nombre de la base de datos
#
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db

# ============================================
# Application Settings
# ============================================
APP_NAME=RAG FastAPI
DEBUG=true

# ============================================
# LLM Configuration (Gemini)
# ============================================
# Obtener gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu-api-key-aqui

# Modelo a usar (opciones: gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.0-flash

# ============================================
# LLM Provider
# ============================================
# Proveedor de LLM a usar: gemini | ollama
# gemini = API de Google (requiere GEMINI_API_KEY)
# ollama = modelo local (requiere Ollama corriendo en localhost)
LLM_PROVIDER=gemini

# ============================================
# Ollama Configuration (solo si LLM_PROVIDER=ollama)
# ============================================
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# Memory Configuration
# ============================================
# Estrategia de memoria activa: none | sliding | summary | vector | hybrid
MEMORY_STRATEGY=none

# Configuración específica por estrategia
MEMORY_SLIDING_WINDOW_SIZE=10
MEMORY_VECTOR_TOP_K=5
MEMORY_SUMMARY_THRESHOLD=20
MEMORY_MAX_CONTEXT_TOKENS=2000

# ============================================
# Multi-Query Retrieval
# ============================================
# Genera N reformulaciones de la query y busca en paralelo para mayor recall.
# Agrega ~1 LLM call extra de latencia. Medir trade-off con Fase 4 (Eval).
MULTI_QUERY_ENABLED=false
MULTI_QUERY_N=3

# ============================================
# Hybrid Search
# ============================================
# Modo de búsqueda: hybrid | semantic_only | lexical_only
# hybrid combina vectorial + BM25 con Reciprocal Rank Fusion.
# Requiere ejecutar: docs/migrations/add_tsvector_hybrid_search.sql
SEARCH_MODE=hybrid
HYBRID_RRF_K=60

# ============================================
# Re-ranking
# ============================================
# Activar para usar un Cross-Encoder que re-ordena los resultados.
# Mejora significativamente la precisión, pero agrega latencia (aprox ~100-300ms).
RERANKING_ENABLED=false
RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKING_TOP_N=5

# ============================================
# Context Compression
# ============================================
# Extrae solo la información relevante de los chunks recuperados antes de pasarlos al LLM.
# Disminuye uso de tokens y alucinaciones, pero consume más LLM calls internos.
CONTEXT_COMPRESSION_ENABLED=false